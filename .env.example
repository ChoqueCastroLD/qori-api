DATABASE_URL="postgresql://USER:PASS@HOST:5432/qori?schema=public"
ADMIN_TOKEN="change-me"
PORT=3000
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://qori.cc/api/auth/google/callback"
WEB_ORIGIN="https://qori.cc"
# Resend (email). Get the key from resend.com; never commit the real value.
