# MercadoPago (charges in local currency; convert from USD).
MP_ACCESS_TOKEN=""
MP_CURRENCY="PEN"
MP_USD_RATE="3.75"
# PayPal (charges in USD). PAYPAL_ENV = live | sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_ENV="live"
