// qori.cc — raffle engine schema.
//
// Design priorities:
//  - Auditability: every draw is reproducible (provably-fair) and every lingote
//    movement is an append-only ledger entry.
//  - Closed-loop currency: lingotes are spent, never withdrawn. 1 USD = 10 lingotes.
//  - Money from real payments is stored in integer minor units (USD cents).
//    Lingotes are whole integers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  // Null for social-only accounts that never set a password.
  passwordHash  String?
  name          String?
  // Public display identity (privacy: real photo is never forced).
  nickname      String?
  avatarUrl     String?
  phone         String?
  country       String? // ISO-3166 alpha-2, for geo-eligibility + T&C version
  role          Role      @default(USER)

  // Cached lingote balance. ALWAYS mutated inside a tx that also appends a
  // LedgerEntry — the ledger is the source of truth; this is a fast read.
  balance Int @default(0)

  // Admin moderation switches + light activity counter.
  canChat     Boolean @default(true)
  canBuy      Boolean @default(true)
  buyAttempts Int     @default(0) // every buy attempt (success or fail)

  // Public handle for the /u/:username profile URL. Changeable once / 15 days.
  username          String?   @unique
  usernameChangedAt DateTime?

  // Referral graph.
  referralCode     String  @unique
  referredBy       User?   @relation("Referrals", fields: [referredById], references: [id])
  referredById     String?
  // True once the +10 lingote first-purchase reward has been paid to referrer.
  referralRewarded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  ledger         LedgerEntry[]
  topups         TopUp[]
  orders         Order[]
  tickets        Ticket[]
  wins           Winner[]
  referrals      User[]         @relation("Referrals")
  confirmedTopups TopUp[]       @relation("TopUpConfirmedBy")
  chatMessages   ChatMessage[]
  activities     Activity[]

  @@index([referredById])
}

// Public activity log for the profile feed (transparency): profile changes and
// anything else worth showing. Ticket purchases come from Order, not here.
model Activity {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // "username_change" | "avatar_change"
  data      Json // { from, to } / { to }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OAuthAccount {
  id                String @id @default(cuid())
  provider          String // e.g. "google"
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  // sha256 of the opaque session token; the raw token lives only in the cookie.
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Wallet (closed-loop lingotes)
// ---------------------------------------------------------------------------

enum LedgerType {
  TOPUP // bought lingotes with real money
  TICKET_BONUS // +1 per ticket
  REFERRAL // +10 first purchase of a referred user
  TICKET_SPEND // spent on tickets
  REFUND // raffle cancelled / below min
  ADJUSTMENT // manual admin correction
}

// Append-only. Never UPDATE or DELETE a row here.
model LedgerEntry {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  amount       Int // + credit, - debit (lingotes)
  balanceAfter Int // user balance immediately after this entry
  type         LedgerType
  // Soft link to the thing that caused it (order id, topup id, raffle id…).
  refType      String?
  refId        String?
  memo         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Payments (real money → lingotes)
// ---------------------------------------------------------------------------

enum TopUpMethod {
  PAYPAL
  YAPE
  PLIN
  TRANSFER
  MERCADOPAGO
  CRYPTO
}

enum TopUpStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model TopUp {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  amountUsd Int // USD cents charged
  lingotes  Int // lingotes credited (amountUsd/100 * 10)
  method    TopUpMethod
  status    TopUpStatus @default(PENDING)

  // Automated providers: external reference. Manual methods: uploaded proof.
  providerRef String?
  proofUrl    String?

  // Settlement breakdown from the payment processor, in the CHARGE currency's
  // minor units (e.g. PEN cents for MercadoPago, USD cents for PayPal).
  chargeCurrency String? // ISO code actually charged (PEN, USD…)
  grossAmount    Int? // what the buyer paid, charge currency
  feeAmount      Int? // processor fee taken (MP/PayPal)
  netAmount      Int? // what we actually receive

  confirmedAt   DateTime?
  confirmedBy   User?     @relation("TopUpConfirmedBy", fields: [confirmedById], references: [id])
  confirmedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Raffles, tickets, orders, draw
// ---------------------------------------------------------------------------

enum RaffleStatus {
  DRAFT // being prepared, not public
  OPEN // selling tickets
  CLOSED // sales ended, awaiting draw
  DRAWING // live show running
  DRAWN // finished, winners set, seed revealed
  CANCELLED // called off; lingotes refunded
}

enum GameType {
  ELIMINATION // tickets eliminated in order until winners remain
  DIGIT_REVEAL // winning number's digits revealed one by one
  BOMBS // tickets blown up in phases
  SQUID // red-light / green-light
  HORSE_RACE // tickets advance steps to the finish
  ICE_FLOOR // chessboard of ice tiles crack in waves until doomed tickets fall through
  MUSICAL_CHAIRS // tickets circle a ring of chairs; losers left without a seat
  ROCKETS // tickets orbit; wandering meteor strikes take out the nearest in waves
  ROULETTE // russian-roulette finale: finalists in a ring, revolver fires until one remains
}

model Raffle {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String       @db.Text
  images      String[]
  prizeValue  Int // USD cents, for display/transparency
  ticketPrice Int // lingotes per ticket (0 = free)
  totalTickets     Int // cupo total
  minTickets       Int @default(1) // below this at draw time → refund/cancel
  maxTicketsPerUser Int? // anti-hoarding; null = unlimited
  winnersCount     Int @default(1)
  // Exclusive raffle: only users who have spent real money (>=1 PAID top-up)
  // can enter. Keeps out freeloaders / free-ticket-only accounts.
  paidOnly    Boolean      @default(false)
  status      RaffleStatus @default(DRAFT)
  // Historical raffle done manually before the platform → not provably-fair.
  legacy      Boolean      @default(false)

  // Which games run in the show. Order is randomized deterministically at draw
  // time; the flashiest game (finale) is placed last.
  games  GameType[]
  finale GameType?
  // Show algorithm version. null/1 = legacy (shuffle winners, per-stage chunks).
  // 2 = per-game deterministic sims (rockets/bombs/ruleta); winners = survivors.
  // Stamped at draw time so already-drawn raffles always re-verify with the
  // exact algorithm that produced them.
  showVersion Int?

  // --- Provably-fair audit trail (see docs/FAIRNESS.md) ---
  commitment    String // sha256(serverSeed), published at OPEN
  entropySource String // human description, e.g. "drand round at draw time"
  serverSeed    String? // revealed only after the show ends
  drandRound    BigInt? // fixed at CLOSE
  drandValue    String? // appears exactly at draw time
  ticketsRoot   String? // merkle root of tickets at CLOSE
  drawDigest    String? // HMAC(serverSeed, publicEntropy)

  opensAt        DateTime?
  closesAt       DateTime? // scheduled draw time
  drawnAt        DateTime?
  extensionCount Int       @default(0) // +24h auto-extensions applied
  extensions     Json?     // log of each postponement [{at, ticketCount, minTickets, from, to}]

  // Admin block switch: hides the raffle from the public + freezes it (no sales,
  // no auto-draw) while blocked. Reason + full on/off log for the history.
  blocked      Boolean @default(false)
  blockReason  String?
  blockHistory Json?   // [{ at, action: "block"|"unblock", reason }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets  Ticket[]
  orders   Order[]
  winners  Winner[]
  show     DrawShow?
  chat     ChatMessage[]

  @@index([status])
}

enum OrderStatus {
  CONFIRMED // lingotes deducted, tickets issued
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  raffle        Raffle      @relation(fields: [raffleId], references: [id])
  raffleId      String
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  quantity      Int
  costLingotes  Int // total lingotes spent
  bonusLingotes Int @default(0) // +1 per ticket credited back
  status        OrderStatus @default(CONFIRMED)
  createdAt     DateTime    @default(now())

  tickets Ticket[]

  @@index([raffleId])
  @@index([userId])
}

model Ticket {
  id       String  @id @default(cuid())
  raffle   Raffle  @relation(fields: [raffleId], references: [id])
  raffleId String
  // 1-based, unique within a raffle; also the canonical draw ordering.
  number   Int
  order    Order?  @relation(fields: [orderId], references: [id])
  orderId  String?
  owner    User?   @relation(fields: [ownerId], references: [id])
  ownerId  String?
  comment  String? // buyer's public note shown on the ticket "character"
  createdAt DateTime @default(now())

  win Winner?

  @@unique([raffleId, number])
  @@index([ownerId])
}

model Winner {
  id       String @id @default(cuid())
  raffle   Raffle @relation(fields: [raffleId], references: [id])
  raffleId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId String @unique
  user     User?  @relation(fields: [userId], references: [id])
  userId   String?
  name     String? // display name for legacy winners without a platform account
  position Int    @default(1) // 1 = first winner, for multi-winner raffles
  createdAt DateTime @default(now())

  // Prize claim: unique code the winner shows (only via Discord to @shoko_cc) to
  // redeem. prizeStatus: PENDING (por reclamar) | DELIVERED (entregado).
  claimCode   String?   @unique
  prizeStatus String    @default("PENDING")
  notifiedAt  DateTime? // when the "you won, claim your prize" email was sent
  deliveredAt DateTime?

  @@unique([raffleId, position])
  @@index([raffleId])
}

// Dedupe for lifecycle emails: one row per (raffle, kind) once sent.
model NotificationLog {
  id        String   @id @default(cuid())
  raffleId  String
  kind      String
  createdAt DateTime @default(now())

  @@unique([raffleId, kind])
}

// Pre-registration email verification codes (OTP). No account exists yet.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Live chat messages per raffle (shown during the show + verification).
model ChatMessage {
  id        String   @id @default(cuid())
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  raffleId  String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  nickname  String
  avatarUrl String?
  text      String   @db.Text
  // The sender's ticket numbers in this raffle at send time (for the live/dead
  // badge shown next to their messages during the show).
  ticketNumbers Int[]  @default([])
  createdAt DateTime @default(now())

  @@index([raffleId, createdAt])
}

// Generated live show: deterministic stage sequence for sync + replay.
model DrawShow {
  id       String @id @default(cuid())
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  raffleId String @unique

  // Full ordered stage data derived from (serverSeed, publicEntropy).
  // Streamed over WebSocket on a timeline; also lets anyone replay/verify.
  stages   Json
  startsAt DateTime // when the synchronized show begins
  endsAt   DateTime?

  createdAt DateTime @default(now())
}
